<?php

define('APP_ROOT', dirname(__DIR__, 2));

if (file_exists(APP_ROOT . '/.env')) {
    $lines = file(APP_ROOT . '/.env', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (strpos(trim($line), '#') === 0) {
            continue;
        }
        [$key, $value] = array_pad(explode('=', $line, 2), 2, '');
        $_ENV[trim($key)] = trim($value);
        $_SERVER[trim($key)] = trim($value);
        putenv(trim($key) . '=' . trim($value));
    }
}

if (session_status() === PHP_SESSION_NONE) {
    ini_set('session.cookie_httponly', '1');
    ini_set('session.cookie_secure', '1');
    ini_set('session.use_strict_mode', '1');
    ini_set('session.cookie_samesite', 'Strict');
    session_start();
}

function env(string $key, mixed $default = null): mixed
{
    return $_ENV[$key] ?? $_SERVER[$key] ?? getenv($key) ?: $default;
}

function respondJson(array $payload, int $status = 200): void
{
    http_response_code($status);
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode($payload, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE);
    exit;
}

function requireAuth(): void
{
    if (empty($_SESSION['user'])) {
        respondJson(['success' => false, 'message' => 'No autorizado.'], 401);
    }
}

function requireRole(array $allowedRoles): void
{
    requireAuth();

    $role = $_SESSION['user']['role_name'] ?? '';
    if (!in_array($role, $allowedRoles, true)) {
        respondJson(['success' => false, 'message' => 'Permisos insuficientes.'], 403);
    }
}

define('APP_NAME', env('APP_NAME', 'EVORIA'));
